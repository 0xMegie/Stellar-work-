NEXT_PUBLIC_CONTRACT_ID=
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_SOROBAN_RPC=https://soroban-testnet.stellar.org
NEXT_PUBLIC_NATIVE_TOKEN=
NEXT_PUBLIC_ADMIN_ADDRESS=

# IPFS description storage (Pinata — https://app.pinata.cloud)
# NEXT_PUBLIC_PINATA_JWT: API key for uploading job descriptions.
# Without this, descriptions are stored in localStorage only (backward-compatible).
NEXT_PUBLIC_PINATA_JWT=
# NEXT_PUBLIC_PINATA_GATEWAY: Your dedicated Pinata gateway subdomain, e.g. "myapp.mypinata.cloud".
# Optional — falls back to public Cloudflare and ipfs.io gateways when unset.
NEXT_PUBLIC_PINATA_GATEWAY=
